APP_PORT=6969
FRONTEND_PORT=3177
MEILI_PORT=7700

# Writable runtime paths. The state directory contains config.json, cards.db,
# cards.db-wal, and cards.db-shm so SQLite snapshots and recovery stay coherent.
ARCHIVE_STATE_DIR=./runtime/state
ARCHIVE_STATIC_DIR=./static
ARCHIVE_DATA_DIR=./data
ARCHIVE_BACKUP_DIR=./backup
MEILI_DATA_DIR=./data.ms
MEILI_DUMP_DIR=./dumps
MEILI_SNAPSHOT_DIR=./snapshots

MEILI_MASTER_KEY=

# External OpenAI-compatible inference. Keep the value in .env or config.json;
# it is intentionally not baked into the image.
EMBEDDING_PROVIDER=openai
EMBEDDING_URL=https://inference.local.vega.nyc
EMBEDDING_API_KEY=

VECTOR_WORKER_BATCH_SIZE=100
VECTOR_MAX_MEILI_TASK_BACKLOG=200
ARCHIVE_IMAGE_TAG=latest
