{
  "name": "character-archive",
  "version": "2.0.0",
  "description": "Character Archive - Node.js Edition",
  "main": "server.js",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "start": "node server.js",
    "predev": "node scripts/predev.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "nodemon server.js",
    "dev:ui": "cross-env TAILWIND_DISABLE_NATIVE=1 npm run dev --prefix frontend",
    "dev:ui:clean": "cross-env TAILWIND_DISABLE_NATIVE=1 npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "prod": "concurrently \"node server.js\" \"npm run start --prefix frontend\"",
    "sync": "node scripts/sync.js",
    "update-metadata": "node scripts/update-metadata.js",
    "import:ct": "node scripts/import-ct-cards.js",
    "sync:search": "node scripts/sync-search.js",
    "sync:meilisearch": "node scripts/sync-meilisearch.js",
    "fix:flags": "node scripts/fix-feature-flags.js",
    "vector:backfill": "node scripts/etl_cards_vector_search.js",
    "vector:backfill:lance": "node scripts/etl_cards_lancedb.js",
    "vector:flush": "node scripts/flush-vector-indexes.js",
    "vector:embedders": "node scripts/ensure-vector-embedders.js",
    "optimize:pngs": "node scripts/optimize-pngs.js",
    "worker:archive": "node scripts/archive-worker.js",
    "worker:vector": "node scripts/vector-worker.js",
    "repair:ct": "node scripts/repair-ct.js",
    "vector:fixture": "node scripts/build-vector-benchmark-fixture.js",
    "vector:benchmark": "node scripts/benchmark-vector-generations.js",
    "test": "node --test config.test.js lib/query-builder.test.js backend/db/schema.test.js backend/db/repositories/CardRepository.test.js backend/db/repositories/SyncRunRepository.test.js backend/db/repositories/VectorGenerationRepository.test.js backend/services/ApiClient.test.js backend/services/ArchiveSourceHandlers.test.js backend/services/ArchiveSyncService.test.js backend/services/CardQueryService.search.test.js backend/services/CtRepairService.test.js backend/services/EmbeddingClient.test.js backend/services/search/lance-filter.test.js backend/services/search/LanceSearchBackend.test.js backend/services/scrapers/BaseScraper.test.js backend/services/scrapers/CtScraper.test.js backend/utils/logger.test.js scripts/etl_cards_lancedb.test.js scripts/vector-benchmark-policy.test.js scripts/vector-etl-contract.test.js scripts/vector-worker-policy.test.js"
  },
  "keywords": [
    "chub",
    "character-cards",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@character-foundry/charx": "^0.0.7",
    "@character-foundry/core": "^0.1.2",
    "@character-foundry/exporter": "^0.1.3",
    "@character-foundry/federation": "^0.2.0",
    "@character-foundry/image-utils": "workspace:^",
    "@character-foundry/loader": "^0.1.9",
    "@character-foundry/schemas": "workspace:^",
    "@lancedb/lancedb": "0.37.1",
    "adm-zip": "^0.5.16",
    "apache-arrow": "18.1.0",
    "axios": "^1.6.5",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "commander": "^11.1.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.0",
    "franc": "^6.1.0",
    "helmet": "^7.1.0",
    "lightningcss": "^1.30.2",
    "meilisearch": "^0.54.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "png-chunk-text": "^1.0.0",
    "png-chunks-encode": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "sharp": "^0.33.5",
    "sqlite3": "^5.1.7",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.2"
  }
}
